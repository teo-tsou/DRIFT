apiVersion: k8s.cni.cncf.io/v1
kind: NetworkAttachmentDefinition
metadata:
  name: {{ network.name | lower | replace('_', '-') | replace(' ', '-') }}
  namespace: {{ network.namespace | default('default') }}
  annotations:
    # Tells Multus this NAD uses KubeOVN as the CNI provider
    k8s.v1.cni.cncf.io/resourceName: ovn-kubernetes.io/ovn
spec:
  config: |
    {
      "cniVersion": "0.3.0",
      "type": "kube-ovn",
      "server_socket": "/run/openvswitch/kube-ovn-daemon.sock",
      "provider": "{{ network.name | lower | replace('_', '-') | replace(' ', '-') }}.{{ network.namespace | default('default') }}.ovn"
    }
